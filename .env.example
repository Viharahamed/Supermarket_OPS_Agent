# Kirana AI Agent Configuration

# Application Settings
APP_NAME=kirana-ai-agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Provider Configuration ('ollama' or 'openrouter')
LLM_PROVIDER=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=60

# OpenRouter Settings (Used when LLM_PROVIDER=openrouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_TIMEOUT=60

# Database Settings
# Development (SQLite):
DATABASE_URL=sqlite:///./data/kirana.db

# Production / Railway (PostgreSQL):
# Standard PostgreSQL: DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/kirana
# Railway PostgreSQL:  DATABASE_URL=postgres://postgres:password@monorail.proxy.rlwy.net:12345/railway

# Database Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Telegram Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MODE=polling  # 'polling' for local dev, 'webhook' for production Railway
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_token_here  # Required when TELEGRAM_MODE=webhook
PUBLIC_BASE_URL=https://your-app.up.railway.app  # Required HTTPS URL when TELEGRAM_MODE=webhook


# Server & Agent Loop Configuration
HOST=0.0.0.0
PORT=8000  # Injected automatically by Railway runtime in production
AGENT_MAX_ITERATIONS=8
TIMEZONE=Asia/Kolkata

# Document Storage & CORS
DOCUMENT_STORAGE=local
LOCAL_DOCUMENT_DIR=generated
CORS_ORIGINS=http://localhost:3000

